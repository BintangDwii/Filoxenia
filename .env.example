PORT=3001
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-password-ini
JWT_SECRET=ganti-dengan-random-string-minimal-32-karakter
DATABASE_PATH=./data/filoxenia.db
NODE_ENV=development

# Turso (cloud SQLite) — wajib di Vercel agar data persisten.
# Kosongkan keduanya untuk fallback ke file lokal (DATABASE_PATH).
TURSO_DATABASE_URL=libsql://filoxenia-<user>.turso.io
TURSO_AUTH_TOKEN=
